# .env.onprem — Sample environment file for self-hosted Koku (on-prem)
#
# Copy this file to .env and fill in the values for your environment:
#   cp .env.onprem .env
#
# Then run:
#   docker build -t koku:onprem .
#   docker compose -f docker-compose.onprem.yml up

# --- PostgreSQL ---
POSTGRES_HOST=your-postgres-host
POSTGRES_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=your-postgres-password

# --- Redis ---
REDIS_HOST=your-redis-host
REDIS_PORT=6379

# --- Kafka ---
KAFKA_HOST=your-kafka-host
KAFKA_PORT=9092

# --- S3 / MinIO ---
S3_ENDPOINT=http://your-minio-host:9000
S3_BUCKET_NAME=koku-bucket
S3_BUCKET_NAME_OCP_INGRESS=ocp-ingress
S3_ACCESS_KEY=your-access-key
S3_SECRET=your-secret-key

# --- Optional tuning ---
# KOKU_PORT=8000
# MASU_PORT=5042
# POD_CPU_LIMIT=1
# GUNICORN_WORKERS=3
# AUTO_DATA_INGEST=True
# RETAIN_NUM_MONTHS=4
# TAG_ENABLED_LIMIT=200
# KOKU_LOG_LEVEL=INFO
# DJANGO_LOG_LEVEL=INFO
# CELERY_LOG_LEVEL=INFO
